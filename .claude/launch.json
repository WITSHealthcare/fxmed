{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "next-dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}