# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SITE_URL=https://www.fxmed.ng
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Search engines (all optional)
# Verification tokens from Google Search Console / Bing Webmaster Tools (the content="" value of their meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Any random 8-128 char hex string; enables instant IndexNow pings to Bing/Yandex when posts are published
INDEXNOW_KEY=

# AI Provider Configuration (choose one or more)

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Hugging Face (Free - Recommended)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Note: Hugging Face provides free AI models. Get your API key from huggingface.co/settings/tokens
