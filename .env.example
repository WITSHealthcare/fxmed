# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider Configuration (choose one or more)

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Hugging Face (Free - Recommended)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Note: Hugging Face provides free AI models. Get your API key from huggingface.co/settings/tokens

# Microsoft Bookings / Teams (auto-creates Teams meetings for telemedicine appointments)
MS_TENANT_ID=your_azure_ad_tenant_id
MS_CLIENT_ID=your_azure_ad_app_client_id
MS_CLIENT_SECRET=your_azure_ad_app_client_secret
MS_BOOKING_BUSINESS_ID=your_bookings_business_id
MS_BOOKING_SERVICE_ID=your_bookings_service_id
# Optional: comma-separated staff member IDs, only needed if the service requires explicit assignment
MS_BOOKING_STAFF_IDS=
